{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SiMarta",
  "version": "1.0.0",
  "identifier": "com.gmist.simarta",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SiMarta - GMIST Maranatha Tahuna",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: http://tauri.localhost; script-src 'self' 'unsafe-inline' 'unsafe-eval' tauri: http://tauri.localhost; style-src 'self' 'unsafe-inline' tauri: http://tauri.localhost; img-src 'self' data: asset: tauri: http://tauri.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
